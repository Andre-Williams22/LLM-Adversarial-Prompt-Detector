# Copy to .env and fill in real values. Never commit .env.
# Every variable here is optional: the service starts and classifies prompts
# with none of them set, degrading only the integrations that need them.

# --- Detection policy -------------------------------------------------------
# One of: high, balanced, conservative. See docs/detection-policy.md.
FAST_DETECTION_SENSITIVITY=balanced

# Load models before the server binds. Leave false so the platform's startup
# probe sees a listening port immediately; readiness is reported on /ready.
EAGER_MODEL_LOAD=false

# --- Runtime ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log   # local debugging only; containers should log to stdout

# --- Experiment tracking (optional) -----------------------------------------
# Unset falls back to a local ./mlruns file store.
MLFLOW_TRACKING_URI=https://your-mlflow-server.example.com

# --- Interaction logging (optional) -----------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=adversarial_detection

# --- Model training and evaluation (optional) -------------------------------
# Only needed by the scripts in src/, not by the served application.
HF_TOKEN=your_huggingface_token_here
MODEL_PATH=outputs/electra/best_model/
